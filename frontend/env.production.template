# Plantilla para build de producción (Vite carga `.env.production` al ejecutar `npm run build`).
# Este archivo SÍ puede versionarse. Los secretos no van aquí.
#
# Uso en tu PC:
#   copy env.production.template .env.production
# Edita `.env.production` con tu dominio real (ese archivo está en .gitignore).

VITE_API_URL=https://cdasoft.com.co/api/v1

# Turnstile: dejar en false hasta tener el widget en Cloudflare con los hostnames reales
# (apex y www por separado si aplica) y sin CSP/WAF bloqueando challenges.cloudflare.com.
# La site key es pública; el secret va solo en el backend (TURNSTILE_SECRET_KEY), mismo widget.
VITE_TURNSTILE_ENABLED=false
# VITE_TURNSTILE_SITE_KEY=
