# Base de datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cdasoft

# Seguridad JWT
SECRET_KEY=cdasoft-secret-key-super-segura-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Aplicación
APP_NAME=CDASOFT
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# SaaS Global Auth (Fase 3)
SAAS_OWNER_EMAIL=owner@cdasoft.com
SAAS_OWNER_PASSWORD=owner123
SAAS_OWNER_NAME=Owner CDASOFT

# Seguridad onboarding (registro de nuevos CDA)
ONBOARDING_RATE_LIMIT_WINDOW_MINUTES=60
ONBOARDING_RATE_LIMIT_MAX_ATTEMPTS_IP=5
ONBOARDING_RATE_LIMIT_MAX_ATTEMPTS_EMAIL=3
TURNSTILE_ENABLED=False
TURNSTILE_SECRET_KEY=
BACKEND_PUBLIC_BASE_URL=http://localhost:8000
TENANT_LOGO_UPLOAD_DIR=uploads/tenant-logos
TENANT_LOGO_MAX_SIZE_MB=4
ONBOARDING_EMAIL_VERIFICATION_REQUIRED=True
ONBOARDING_EMAIL_CODE_TTL_MINUTES=15
ONBOARDING_EMAIL_CODE_MAX_ATTEMPTS=5

# CORS (URLs del frontend)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# URLs sistemas externos
RUNT_URL=https://b2crunt2prd.b2clogin.com/runtprologin.runt.gov.co/b2c_1a_singin/oauth2/v2.0/authorize?client_id=4e0d509e-3bb5-44b9-b712-53e221b97393&scope=https%3A%2F%2FB2Crunt2prd.onmicrosoft.com%2FRNFTransversalMS%2Faccess.all%20openid%20profile%20offline_access&redirect_uri=https%3A%2F%2Fruntpro.runt.gov.co%2F
SICOV_URL=https://sicovindra.com:9093/
INDRA_URL=https://indra.paynet.com.co:14443/Login.aspx?ReturnUrl=%2fInformacionSeguridad.aspx

# Facturación electrónica Factus (https://developers.factus.com.co/)
FACTUS_SANDBOX_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_PRODUCTION_BASE_URL=https://api.factus.com.co
# Opcional: clave dedicada para cifrar secretos en BD; si vacío se usa derivación desde SECRET_KEY
FACTUS_ENCRYPTION_KEY=
# ID municipio DIAN en Factus (cliente/establecimiento) si no hay dato por sede
FACTUS_DEFAULT_MUNICIPALITY_ID=980
# Tarifa IVA general Colombia (DIAN). Base con IVA incluido = total / (1 + tarifa/100)
FACTUS_IVA_PORCENTAJE_GENERAL=19
FACTUS_MONEDA_DECIMALES=2
