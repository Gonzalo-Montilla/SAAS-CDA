# =============================================================================
# CDASOFT — Backend (FastAPI)
# =============================================================================
# INSTRUCCIONES
#   1. Copia este archivo:  cp .env.example .env
#   2. Rellena valores reales. No commitees .env.
#   3. En PRODUCCIÓN: revisa además PRODUCTION_CHECKLIST.md (raíz del repo)
#      y backend/GUIA_ENV_PRODUCCION.md
#
# Valores mostrados abajo son para DESARROLLO LOCAL salvo que se indique.
# =============================================================================

# --- Base de datos (obligatorio) ---
# Producción: usuario dedicado, contraseña fuerte. Caracteres especiales en la
# contraseña deben ir codificados en la URL (RFC 3986).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cdasoft

# --- Seguridad JWT (obligatorio) ---
# Producción: generar con  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAR-en-produccion-usar-secrets-token-urlsafe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Aplicación ---
APP_NAME=CDASOFT
APP_VERSION=1.0.0
# development = expone /docs y /redoc. Producción: usar "production".
ENVIRONMENT=development
# Producción: False siempre
DEBUG=True

# --- SaaS: propietario del backoffice global ---
# PRODUCCIÓN: cambiar email y contraseña; nunca dejar owner123 expuesto.
SAAS_OWNER_EMAIL=owner@cdasoft.com
SAAS_OWNER_PASSWORD=owner123
SAAS_OWNER_NAME=Owner CDASOFT

# --- Onboarding de nuevos tenants (registro público) ---
ONBOARDING_RATE_LIMIT_WINDOW_MINUTES=60
ONBOARDING_RATE_LIMIT_MAX_ATTEMPTS_IP=5
ONBOARDING_RATE_LIMIT_MAX_ATTEMPTS_EMAIL=3
TURNSTILE_ENABLED=False
TURNSTILE_SECRET_KEY=
BACKEND_PUBLIC_BASE_URL=http://localhost:8000
TENANT_LOGO_UPLOAD_DIR=uploads/tenant-logos
TENANT_LOGO_MAX_SIZE_MB=4
ONBOARDING_EMAIL_VERIFICATION_REQUIRED=True
ONBOARDING_EMAIL_CODE_TTL_MINUTES=15
ONBOARDING_EMAIL_CODE_MAX_ATTEMPTS=5

# --- Módulo documental (archivos privados por tenant) ---
# DOCUMENTOS_STORAGE_DIR=private_uploads/documentos
# DOCUMENTOS_MAX_SIZE_MB=25
# Ruta al soffice de LibreOffice para vista previa PDF de Office (.docx, etc.). Vacío = autodetección.
# DOCUMENTOS_LIBREOFFICE_PATH=

# --- CORS: orígenes del frontend (obligatorio acotar en producción) ---
# Lista separada por comas, o JSON array. NO usar * en producción.
# Ejemplo prod: https://app.tudominio.com,https://www.tudominio.com
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Correo (enlaces en emails, recuperación, onboarding) ---
# Producción: credenciales reales; Gmail suele requerir "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# URL que abren los usuarios al hacer clic en enlaces del correo (HTTPS en prod)
FRONTEND_URL=http://localhost:5173

# --- Localización (opcional; valores por defecto suelen bastar) ---
TIMEZONE=America/Bogota
LOCALE=es_CO

# --- URLs sistemas externos (RUNT, SICOV, INDRA) ---
RUNT_URL=https://b2crunt2prd.b2clogin.com/runtprologin.runt.gov.co/b2c_1a_singin/oauth2/v2.0/authorize?client_id=4e0d509e-3bb5-44b9-b712-53e221b97393&scope=https%3A%2F%2FB2Crunt2prd.onmicrosoft.com%2FRNFTransversalMS%2Faccess.all%20openid%20profile%20offline_access&redirect_uri=https%3A%2F%2Fruntpro.runt.gov.co%2F
SICOV_URL=https://sicovindra.com:9093/
INDRA_URL=https://indra.paynet.com.co:14443/Login.aspx?ReturnUrl=%2fInformacionSeguridad.aspx

# --- Facturación electrónica Factus (https://developers.factus.com.co/) ---
FACTUS_SANDBOX_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_PRODUCTION_BASE_URL=https://api.factus.com.co
# Opcional: clave dedicada para cifrar secretos en BD; si vacío se deriva de SECRET_KEY
FACTUS_ENCRYPTION_KEY=
FACTUS_DEFAULT_MUNICIPALITY_ID=980
FACTUS_IVA_PORCENTAJE_GENERAL=19
FACTUS_MONEDA_DECIMALES=2
